<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Та же логика целей, что и у основного проекта: .NET 10 при новом SDK
         и net9.0-windows на Visual Studio 2022. -->
    <SdkSupportsNet10 Condition="'$(NETCoreSdkVersion)' != ''">$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))</SdkSupportsNet10>
    <SdkSupportsNet10 Condition="'$(SdkSupportsNet10)' == ''">false</SdkSupportsNet10>
    <TargetFramework Condition="'$(SdkSupportsNet10)' != 'true'">net9.0-windows</TargetFramework>
    <TargetFrameworks Condition="'$(SdkSupportsNet10)' == 'true'">net10.0-windows;net9.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaceLog.Checks</RootNamespace>
    <AssemblyName>Проверки</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaceLog\RaceLog.csproj" />
  </ItemGroup>

</Project>
